---
import '../styles/global.css';
// jsonLd: ページごとの構造化データ(schema.org)。配列で複数渡せる
interface Props { title: string; description?: string; ogType?: 'website' | 'article'; jsonLd?: object[] }
const { title, description = '実際に届いた詐欺SMS・フィッシングメールの事例と対策をまとめています。', ogType = 'website', jsonLd = [] } = Astro.props;
const siteName = '詐欺SMS実録ノート';
// 404 はどのURLでも表示されるので canonical を付けない
const canonical = Astro.url.pathname.startsWith('/404') ? null : new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | {siteName}</title>
  <meta name="description" content={description} />
  {canonical ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
  <meta property="og:site_name" content={siteName} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="ja_JP" />
  {canonical && <meta property="og:url" content={canonical} />}
  <meta property="og:image" content={new URL('/og.png', Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${siteName}:実際に届いた詐欺SMS・フィッシングメールの文面と、見分け方・対処法`} />
  <meta name="twitter:card" content="summary_large_image" />
  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d).replace(/</g, '\\u003c')} />)}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700&family=Noto+Serif+JP:wght@700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="inner">
      <a class="brand" href="/">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>
        {siteName}
      </a>
      <nav class="site-nav">
        <a href="/cases/">詐欺事例</a>
        <a href="/guide/">対策ガイド</a>
      </nav>
    </div>
  </header>
  <div class="wrap"><slot /></div>
  <footer class="site-footer">
    <div class="inner">
      <div>当サイトは広告(アフィリエイト)を含みます。</div>
      <div><a href="/about/">運営者情報</a><a href="/privacy/">プライバシーポリシー</a><a href="/disclaimer/">免責事項</a></div>
    </div>
  </footer>
</body>
</html>
