---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import { getGroups, formatDate } from '../lib/sheet';
import { website } from '../lib/jsonld';
const groups = await getGroups();
const latest = groups.slice(0, 10);
const description = `実際に届いた詐欺SMS・フィッシングメール${groups.length}種類の文面を、なりすまし先と手口ごとに掲載。「このメッセージは本物?」と迷ったときに同じ文面を探せ、見分け方と対処法も確認できます。`;
---
<Base title="実際に届いた詐欺SMS・フィッシングメールの事例と対策" description={description} jsonLd={[website(Astro.site!, description)]}>
  <div class="layout">
    <div class="article">
      <h1>実際に届いた詐欺SMS・フィッシングメールの事例と対策</h1>
      <p>運営者の手元に毎日届く詐欺SMSやフィッシングメールを記録し、見分け方と対処法をまとめています。「このメッセージは本物?」と迷ったら、同じ文面が届いていないか確かめてください。</p>
      <p><a href="/guide/">見分け方と対処法をまとめた対策ガイドはこちら</a></p>
      <h2>最近の事例</h2>
      <ul class="list">
        {latest.map((g) => <li><a href={`/cases/${g.slug}/`}><span class="t">{g.spoof}を装った「{g.method}」</span><br /><span class="note">{g.media}/最新の受信:{formatDate(g.latest)}/{g.total}件</span></a></li>)}
      </ul>
      <p><a href="/cases/">すべての事例を見る</a></p>
    </div>
    <Sidebar />
  </div>
</Base>
