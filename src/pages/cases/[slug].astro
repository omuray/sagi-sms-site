---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import PrSecurity from '../../components/PrSecurity.astro';
import { getGroups, formatDate, type CaseGroup } from '../../lib/sheet';
import { TITLE_OVERRIDES, caseTitleParts, spoofPhrase, caseLabel, spoofCategory, NOT_PHISHING_METHODS } from '../../lib/slugs';
import { getRelated } from '../../lib/related';

export async function getStaticPaths() {
  const groups = await getGroups();
  return groups.map((g) => ({ params: { slug: g.slug }, props: { group: g } }));
}

const { group } = Astro.props as { group: CaseGroup };
const guide = (await getEntry('guides', group.slug)) ?? (await getEntry('guides', 'default'));
const { Content } = await render(guide!);
// タイトルの組み立て方は src/lib/slugs.ts の caseTitleParts(OGP画像と共通)
const override = TITLE_OVERRIDES[group.slug] ?? {};
const { spoof: titleSpoof, method, methodShort, title } = caseTitleParts(group);
// ページごとのOGP画像(src/pages/og/cases/[slug].png.ts が作る)
const ogImage = `/og/cases/${group.slug}.png`;
const mediaLabel = group.media === 'SNS' ? 'SNSのメッセージ' : group.media;
const phrase = spoofPhrase(group);
// 導入文で「詐欺(フィッシング)です」と書くかどうか。電話と、勧誘・架空請求などの手口は書かない
const phishing = group.media !== '電話' && !NOT_PHISHING_METHODS.has(group.method);
// 本文冒頭の導入文と説明文(検索結果に出る文)で引用する文:最新の文面の1行目(メールなら件名)。届いたものと見比べられるようにする
// 伏せ字([メールアドレス]、CL=*** など)と、< > だけの行(<楽天サポート> などの見出し)は除き、1行目が短いときは2行目もつなげる
const lines = group.cases[0].body
  .replace(/\[[^\]\n]*\]|[A-Za-z]+\s*[=:]\s*\*{3}/g, '')
  .split(/\r?\n/).map((l) => l.replace(/\s+/g, ' ').trim()).filter((l) => l && !/^<[^<>]*>$/.test(l));
// 私用領域の文字(Apple のロゴ U+F8FF など)は多くの端末で空白や□になるので外す
const head = ([...(lines[0] ?? '')].length < 12 ? lines.slice(0, 2).join(' ') : lines[0])
  .replace(/[-]/g, '').replace(/\s+/g, ' ').trim();
const quote = clipQuote(head);

// 引用文を言葉の途中で切らずに縮める(「〜確認のお願…」のような切れ方を防ぐ)
// 1. 36字以内なら全文 2. 18〜30字目の区切り(句読点・閉じ括弧・空白など)の一番後ろで切る
// 3. 区切りがない(またはそれより手前にしかなく短くなりすぎる)ときは日本語の単語の切れ目で切る
function clipQuote(text: string, max = 30, min = 18, whole = 36): string {
  const chars = [...text];
  if (chars.length <= whole) return text;
  let cut = 0;
  for (let i = min; i <= max; i++) {
    const prev = chars[i - 1], next = chars[i];
    if (/[。！？!?」』）)】、：:｜|]/.test(prev) || /[\s｜|【「（(-]/.test(next)) cut = i;
  }
  if (!cut) {
    // 文字の位置(code point)で数えるため、単語の切れ目も文字数に直して比べる
    let pos = 0;
    for (const { segment } of new Intl.Segmenter('ja', { granularity: 'word' }).segment(text)) {
      const len = [...segment].length;
      if (pos + len > max) break;
      pos += len;
    }
    cut = pos >= min ? pos : max;
  }
  return `${chars.slice(0, cut).join('').replace(/[\s、・｜|:：\-]+$/, '')}…`;
}
const arrive = group.media === '電話' ? 'という' : 'と届く';
const description = `「${quote}」${arrive}${phrase}詐欺${group.media}の実例${group.total}件(最新:${formatDate(group.latest)})。${method && `「${override.method ?? group.method}」の`}見分け方と、URLを開いてしまったときの対処法を掲載。`;
// ほかの事例:選び方は src/lib/related.ts
const related = (await getRelated()).get(group.slug) ?? [];

// シートの日付が読めない行があってもビルドを止めない
const times = group.cases.map((c) => c.date.getTime()).filter((t) => !Number.isNaN(t));
const site = Astro.site!;
const pageUrl = new URL(Astro.url.pathname, site).href;
// パンくず(画面):ホーム › 詐欺事例 › なりすまし先(一覧の該当箇所) › 手口
// 構造化データでは、なりすまし先の段を外して ホーム › 詐欺事例 › 手口 にする
// (なりすまし先の段は /cases/#〇〇 のアンカー付きURLで、Google は # 以降を無視して「詐欺事例」と同じURL扱いにするため。
//  item は最後の段以外で必須なので、item を省くのではなく段ごと外す)
const spoofAnchor = `/cases/#${encodeURIComponent(group.spoof)}`;
const category = spoofCategory(group.spoof);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: '詐欺事例', item: new URL('/cases/', site).href },
      // なりすまし先の段を外した分、最後の段の名前になりすまし先を含める。呼び方は h1 と同じ(例:楽天「不在通知」)
      { '@type': 'ListItem', position: 3, name: `${titleSpoof}${method}` || methodShort, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    mainEntityOfPage: pageUrl,
    datePublished: times.length ? new Date(Math.min(...times)).toISOString() : undefined,
    dateModified: times.length ? new Date(Math.max(...times)).toISOString() : undefined,
    image: new URL(ogImage, site).href,
    author: { '@type': 'Organization', name: '詐欺SMS実録ノート', url: new URL('/about/', site).href },
    publisher: { '@type': 'Organization', name: '詐欺SMS実録ノート', url: new URL('/', site).href },
  },
];
---
<Base title={title} description={description} ogType="article" jsonLd={jsonLd} titleSuffix={false} ogImage={ogImage} ogImageAlt={title}>
  <div class="crumb"><a href="/">ホーム</a> › <a href="/cases/">詐欺事例</a> › <a href={spoofAnchor}>{category}</a> › {methodShort}</div>
  <div class="layout">
    <article class="article">
      <div class="tags">
        <span class="tag solid">{group.media}</span>
        <span class="tag">{category}</span>
        <span class="tag">{group.method}</span>
      </div>
      <h1>{title}</h1>
      <div class="meta">
        <span>最新の受信:{formatDate(group.latest)}</span>
        <span>確認した件数:{group.total}件</span>
        <span>文面の種類:{group.cases.length}種類</span>
      </div>
      <p>「{quote}」という{mediaLabel}が届いたら、{phrase}詐欺{phishing && '(フィッシング)'}です。同じ手口の文面をこれまでに{group.total}件確認しています。</p>
      <p class="verdict"><strong>結論:</strong>{guide!.data.summary}</p>

      <h2>実際に届いたメッセージ</h2>
      <div class="sms-box">
        {group.cases.map((c) => (
          <div class="sms">
            <div class="info">{formatDate(c.date)} 受信{c.count > 1 && `(同じ文面を${c.count}回受信)`}</div>
            <div class="bubble">{c.body}</div>
          </div>
        ))}
        <div class="note">※URLは誤ってアクセスしないよう無害化して掲載しています。送信元の番号は偽装や乗っ取りの可能性があるため掲載していません。</div>
      </div>

      <div class="guide"><Content /></div>
      <p>ほかの手口にも共通する見分け方や、被害にあったときの相談窓口は<a href="/guide/">対策ガイド</a>にまとめています。</p>

      {group.official && (
        <>
          <h2>公式の注意喚起</h2>
          <a class="official" href={group.official} target="_blank" rel="noopener">
            <span><strong>{category}の公式案内</strong><br /><span class="note">公式サイトで最新の情報を確認できます</span></span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
          </a>
        </>
      )}

      <h2>今日からできる対策</h2>
      <div class="panel">
        <strong>まずは無料で:携帯キャリアの迷惑SMSフィルタをオンにする</strong>
        <p style="margin:6px 0 0;color:var(--body)">各キャリアの無料の拒否設定で、詐欺SMSの多くを受信前に止められます。</p>
      </div>
      <PrSecurity limit={1} />
      <p>無料の設定とセキュリティアプリでできること・できないこと、選ぶときの確認点は<a href="/guide/security-app/">セキュリティアプリの選び方</a>にまとめています。</p>

      {related.length > 0 && (
        <>
          <h2>関連する事例</h2>
          <ul class="list">
            {related.map((g) => <li><a href={`/cases/${g.slug}/`}><span class="t">{caseLabel(g)}</span><br /><span class="note">最新の受信:{formatDate(g.latest)}</span></a></li>)}
          </ul>
        </>
      )}
    </article>
    <Sidebar />
  </div>
</Base>
