---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getGroups, formatDate, type CaseGroup } from '../../lib/sheet';
import { METHOD_SHORT, SPOOF_DISPLAY } from '../../lib/slugs';

export async function getStaticPaths() {
  const groups = await getGroups();
  return groups.map((g) => ({ params: { slug: g.slug }, props: { group: g } }));
}

const { group } = Astro.props as { group: CaseGroup };
const guide = (await getEntry('guides', group.slug)) ?? (await getEntry('guides', 'default'));
const { Content } = await render(guide!);
// 例:Amazon「支払い情報の更新」詐欺メールの文面と見分け方
// なりすまし先は表示名を使い、手口の名前に含まれる場合(有名人「有名人なりすまし」など)は省く
const methodShort = METHOD_SHORT[group.method] ?? group.method;
const method = group.method === 'その他' ? '' : `「${methodShort}」`;
const spoofName = SPOOF_DISPLAY[group.spoof] ?? group.spoof;
const spoofLabel = spoofName && !group.method.includes(spoofName) ? spoofName : '';
const title = group.media === '電話'
  ? `${spoofLabel}${method}詐欺電話の内容と見分け方`
  : `${spoofLabel}${method}詐欺${group.media}の文面と見分け方`;
// 本文冒頭の導入文:最新の文面の書き出しを引用して、届いたものと同じか確かめやすくする
const opening = [...group.cases[0].body.replace(/\s+/g, ' ').trim()];
const quote = opening.length > 30 ? `${opening.slice(0, 30).join('')}…` : opening.join('');
const mediaLabel = group.media === 'SNS' ? 'SNSのメッセージ' : group.media;
const spoofPhrase = spoofLabel ? `${spoofLabel}を装った` : '';
const description = `${spoofPhrase}「${group.method}」の詐欺${group.media}を${group.total}件確認(最新の受信:${formatDate(group.latest)})。実際に届いた文面${group.cases.length}種類と見分け方、URLを開いてしまったときの対処法をまとめています。`;
// ほかの事例:同じなりすまし先 → 同じ手口 → 新しい順で、5件まで
const others = (await getGroups()).filter((g) => g.slug !== group.slug);
const related = [
  ...others.filter((g) => g.spoof === group.spoof),
  ...others.filter((g) => g.spoof !== group.spoof && g.method === group.method),
  ...others.filter((g) => g.spoof !== group.spoof && g.method !== group.method),
].slice(0, 5);

// シートの日付が読めない行があってもビルドを止めない
const times = group.cases.map((c) => c.date.getTime()).filter((t) => !Number.isNaN(t));
const site = Astro.site!;
const pageUrl = new URL(Astro.url.pathname, site).href;
// パンくず:ホーム › 詐欺事例 › なりすまし先(一覧の該当箇所) › 手口。画面と構造化データで同じ並びにする
const spoofAnchor = `/cases/#${encodeURIComponent(group.spoof)}`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: '詐欺事例', item: new URL('/cases/', site).href },
      { '@type': 'ListItem', position: 3, name: group.spoof, item: new URL(spoofAnchor, site).href },
      { '@type': 'ListItem', position: 4, name: methodShort, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    mainEntityOfPage: pageUrl,
    datePublished: times.length ? new Date(Math.min(...times)).toISOString() : undefined,
    dateModified: times.length ? new Date(Math.max(...times)).toISOString() : undefined,
    image: new URL('/og.png', site).href,
    author: { '@type': 'Organization', name: '詐欺SMS実録ノート', url: new URL('/about/', site).href },
    publisher: { '@type': 'Organization', name: '詐欺SMS実録ノート', url: new URL('/', site).href },
  },
];
// PR枠:A8.net の広告リンク(ウイルスバスター クラウド)。prUrl を空にするとPR枠ごと出さない
// prPixel は A8.net の表示回数の計測用画像。リンクコードの <img> の src をそのまま入れる
const prUrl = 'https://px.a8.net/svt/ejp?a8mat=4BEAWV+GGEES2+3A66+626XU';
const prPixel = 'https://www11.a8.net/0.gif?a8mat=4BEAWV+GGEES2+3A66+626XU';
---
<Base title={title} description={description} ogType="article" jsonLd={jsonLd}>
  <div class="crumb"><a href="/">ホーム</a> › <a href="/cases/">詐欺事例</a> › <a href={spoofAnchor}>{group.spoof}</a> › {methodShort}</div>
  <div class="layout">
    <article class="article">
      <div class="tags">
        <span class="tag solid">{group.media}</span>
        <span class="tag">{group.spoof}</span>
        <span class="tag">{group.method}</span>
      </div>
      <h1>{title}</h1>
      <div class="meta">
        <span>最新の受信:{formatDate(group.latest)}</span>
        <span>確認した件数:{group.total}件</span>
        <span>文面の種類:{group.cases.length}種類</span>
      </div>
      <p>「{quote}」という{mediaLabel}が届いたら、{spoofPhrase}詐欺です。同じ手口の文面をこれまでに{group.total}件確認しています。</p>
      <p class="verdict"><strong>結論:</strong>{guide!.data.summary}</p>

      <h2>実際に届いたメッセージ</h2>
      <div class="sms-box">
        {group.cases.map((c) => (
          <div class="sms">
            <div class="info">{formatDate(c.date)} 受信{c.count > 1 && `(同じ文面を${c.count}回受信)`}</div>
            <div class="bubble">{c.body}</div>
          </div>
        ))}
        <div class="note">※URLは誤ってアクセスしないよう無害化して掲載しています。送信元の番号は偽装や乗っ取りの可能性があるため掲載していません。</div>
      </div>

      <div class="guide"><Content /></div>
      <p>ほかの手口にも共通する見分け方や、被害にあったときの相談窓口は<a href="/guide/">対策ガイド</a>にまとめています。</p>

      {group.official && (
        <>
          <h2>公式の注意喚起</h2>
          <a class="official" href={group.official} target="_blank" rel="noopener">
            <span><strong>{group.spoof}の公式案内</strong><br /><span class="note">公式サイトで最新の情報を確認できます</span></span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M8 7h9v9"/></svg>
          </a>
        </>
      )}

      <h2>今日からできる対策</h2>
      <div class="panel">
        <strong>まずは無料で:携帯キャリアの迷惑SMSフィルタをオンにする</strong>
        <p style="margin:6px 0 0;color:var(--body)">各キャリアの無料の拒否設定で、詐欺SMSの多くを受信前に止められます。</p>
      </div>
      {prUrl && (
        <div class="panel pr" style="margin-top:16px">
          <p style="margin:0 0 12px"><span class="pr-label">PR</span><strong>さらに強化したい方へ</strong></p>
          <p style="margin:0 0 12px"><strong>ウイルスバスター クラウド</strong>:トレンドマイクロのセキュリティソフトです。危険なウェブサイトへのアクセスをブロックする機能があり、詐欺メッセージのURLを誤って開いてしまったときの備えになります。パソコンとスマホの両方で使えます。</p>
          <a class="btn" href={prUrl} target="_blank" rel="sponsored nofollow noopener">公式オンラインショップを見る</a>
          <img src={prPixel} width="1" height="1" alt="" loading="lazy" style="border:0;position:absolute" />
        </div>
      )}

      {related.length > 0 && (
        <>
          <h2>関連する事例</h2>
          <ul class="list">
            {related.map((g) => <li><a href={`/cases/${g.slug}/`}><span class="t">{g.spoof}を装った「{g.method}」</span><br /><span class="note">最新の受信:{formatDate(g.latest)}</span></a></li>)}
          </ul>
        </>
      )}
    </article>
    <Sidebar />
  </div>
</Base>
