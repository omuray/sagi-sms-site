---
import Base from '../../../layouts/Base.astro';
import Sidebar from '../../../components/Sidebar.astro';
import PrSecurity from '../../../components/PrSecurity.astro';
import { breadcrumb } from '../../../lib/jsonld';
import { prProducts } from '../../../lib/pr';
// 無料の対策を先に、セキュリティアプリは「もう一段の備え」として紹介する
// 製品の紹介(PR枠)は本文と分けて最後に置く。広告のリンクは src/lib/pr.ts
---
<!-- title は検索結果で切れないよう末尾のサイト名を付けない(事例ページと同じ)。h1 と同じ文にする -->
<Base titleSuffix={false} title="詐欺SMS・フィッシング対策アプリの選び方と無料の設定" description="詐欺SMS・フィッシングメールへの備えとして、無料でできる迷惑SMSフィルタや危険サイトの警告の設定と、セキュリティアプリでできること・できないこと、選ぶときの確認点をまとめています。" jsonLd={[breadcrumb(Astro.site!, [['ホーム', '/'], ['対策ガイド', '/guide/'], ['セキュリティアプリの選び方', '/guide/security-app/']])]}>
  <div class="crumb"><a href="/">ホーム</a> › <a href="/guide/">対策ガイド</a> › セキュリティアプリの選び方</div>
  <div class="layout">
    <article class="article">
      <h1>詐欺SMS・フィッシング対策アプリの選び方と無料の設定</h1>
      <p class="verdict"><strong>基本:</strong>まずは無料の設定から。セキュリティアプリは、それでも届く・開いてしまうときの「もう一段の備え」です。</p>
      <div class="guide">
        <h2>まずは無料でできる設定</h2>
        <ul>
          <li><strong>携帯キャリアの迷惑SMSフィルタ</strong>:ドコモ・au・ソフトバンク・楽天モバイルなど、各キャリアに無料の拒否設定があります。設定方法は、契約しているキャリアの公式サイトで確認できます。</li>
          <li><strong>スマホの標準のフィルタ</strong>:iPhone は「設定」の「メッセージ」で、連絡先にない差出人のメッセージを分けて表示できます。Android は「Google メッセージ」の設定で、迷惑メッセージ対策(スパム保護)をオンにします。</li>
          <li><strong>ブラウザの危険サイトの警告</strong>:Safari の「詐欺Webサイトの警告」、Chrome の「セーフ ブラウジング」がオンになっているか確認します。報告済みの偽サイトを開こうとすると、警告が表示されます。</li>
        </ul>

        <h2>セキュリティアプリでできること</h2>
        <ul>
          <li><strong>危険なサイトをブロックする</strong>:URLを開いてしまっても、偽サイトとして知られているページの表示を止めます。詐欺メッセージへの備えとして、いちばん役に立つ機能です。</li>
          <li><strong>迷惑SMSを振り分ける</strong>:詐欺の可能性があるSMSを、受信箱とは別の場所に分けます。</li>
          <li><strong>迷惑電話を知らせる</strong>:詐欺に使われた番号からの着信を警告する機能を持つものもあります。</li>
        </ul>

        <h2>できないこと・注意点</h2>
        <ul>
          <li><strong>すべての詐欺は防げない</strong>:偽サイトは毎日のように新しく作られます。作られたばかりのサイトは、ブロックの対象になる前にすり抜けることがあります。アプリを入れても、「メッセージのURLは開かない」という基本は変わりません。</li>
          <li><strong>iPhone では機能が限られる</strong>:iPhone のアプリは、SMSの中身を自由に調べることができません。できるのは、迷惑SMSの振り分けと、ブラウザでの危険サイトのブロックが中心です。</li>
          <li><strong>偽のセキュリティアプリに注意</strong>:「ウイルスに感染しています」と表示して、アプリを入れさせる手口があります。アプリは App Store か Google Play から、提供元を確かめて入れます。</li>
        </ul>

        <h2>選ぶときの確認点</h2>
        <ul>
          <li><strong>危険サイトのブロック機能があるか</strong>:詐欺メッセージへの備えとしては、この機能があるかどうかが一番の確認点です。</li>
          <li><strong>自分の端末で使える機能か</strong>:iPhone と Android では、使える機能が違います。対応している機能の一覧を、公式サイトで確認します。</li>
          <li><strong>契約中のプランに含まれていないか</strong>:携帯キャリアの有料オプションや、インターネット回線のプロバイダの特典で、セキュリティアプリがすでに使えることがあります。新しく申し込む前に確認すると、二重の契約を避けられます。</li>
          <li><strong>何台まで使えるか</strong>:家族のスマホやパソコンにも入れるなら、複数台で使える製品が割安です。特に高齢の家族の端末に入れておくと安心です。</li>
          <li><strong>無料の体験期間があるか</strong>:体験期間のある製品なら、使い勝手を確かめてから決められます。</li>
        </ul>
      </div>

      {prProducts.length > 0 && (
        <>
          <h2>紹介している製品</h2>
          <PrSecurity />
        </>
      )}

      <h2>届いてしまったときは</h2>
      <p>見分け方や、URLを開いてしまったときの対処法、相談窓口は<a href="/guide/">対策ガイド</a>にまとめています。同じ文面が届いていないかは、<a href="/cases/">詐欺事例の一覧</a>で確かめられます。</p>
    </article>
    <Sidebar />
  </div>
</Base>
