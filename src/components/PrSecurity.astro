---
// セキュリティソフトのPR枠(事例ページと、セキュリティアプリの選び方のページで使う)
// 広告のリンクは src/lib/pr.ts
import { prProducts } from '../lib/pr';
---
{prProducts.length > 0 && (
  <div class="panel pr" style="margin-top:16px">
    <p style="margin:0 0 12px"><span class="pr-label">PR</span><strong>さらに強化したい方へ</strong></p>
    {prProducts.map((p, i) => (
      <div style={i > 0 ? 'margin-top:20px' : undefined}>
        <p style="margin:0 0 12px"><strong>{p.name}</strong>:{p.text}</p>
        <a class="btn" href={p.url} target="_blank" rel="sponsored nofollow noopener">{p.button}</a>
        <img src={p.pixel} width="1" height="1" alt="" loading="lazy" style="border:0;position:absolute" />
      </div>
    ))}
  </div>
)}
